{
  "name": "atomicip",
  "version": "1.0.0",
  "description": "Atomic Patent - Decentralized IP Registry on Stellar Soroban",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "benchmark:compressor": "jest --testPathPatterns=\"benchmark-batchCompressor\"",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "keywords": [
    "blockchain",
    "stellar",
    "soroban",
    "intellectual-property",
    "atomic-swap"
  ],
  "author": "Atomic Patent Contributors",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.54.0",
    "fast-check": "^3.22.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.js",
      "<rootDir>/src/**/*.test.js",
      "<rootDir>/scripts/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/__tests__/**",
      "!src/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
