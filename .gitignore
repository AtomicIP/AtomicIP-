# ── Build artefacts ────────────────────────────────────────────────────────────
target/
**/target/
*.wasm
*.wasm.gz

# ── Soroban / Stellar test snapshots ──────────────────────────────────────────
# Generated by soroban-sdk snapshot testing; must not be committed.
**/test_snapshots/
**/*.snap
**/*.snap.new

# ── Cargo lock files (inner workspaces) ───────────────────────────────────────
# The root Cargo.lock is kept (recommended for binary crates / reproducible CI).
# Inner workspace Cargo.lock files for independent sub-crates are excluded.
api-server/Cargo.lock

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
secrets.toml

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.orig
*.bak

# ── Operating system ──────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
._*

# ── Fuzz artefacts ────────────────────────────────────────────────────────────
fuzz/artifacts/
fuzz/corpus/*/crashes/
fuzz/corpus/*/queue/
fuzz/corpus/*/timeouts/

# Compiled WASM outputs (tracked only if intentionally committed)
*.wasm

# Node.js (api-server / JS tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage artifacts
lcov.info
coverage/
*.profraw
*.profdata

# Temporary / generated
*.tmp
*.log

# ── Project-internal notes (not for the repo) ─────────────────────────────────
vrickish.md
TODO.local.md
NOTES.md
